{
    "name": "@diia-inhouse/validators",
    "version": "2.2.8",
    "type": "module",
    "description": "Data validators package",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "repository": "https://github.com/diia-open-source/be-pkg-validators",
    "author": "Diia",
    "license": "SEE LICENCE IN LICENCE.md",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsdown",
        "semantic-release": "semantic-release -e @diia-inhouse/configs/dist/semantic-release/service-stage ",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "find-circulars": "madge --circular ./"
    },
    "dependencies": {
        "bson": "7.2.0",
        "fastest-validator": "1.19.1",
        "lodash.frompairs": "4.0.1",
        "luxon": "3.7.2"
    },
    "peerDependencies": {
        "@diia-inhouse/errors": ">=2.0.0",
        "@diia-inhouse/types": ">=13.1.0"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.0.0",
        "@diia-inhouse/errors": "2.1.4",
        "@diia-inhouse/oxc-config": "1.10.0",
        "@diia-inhouse/test": "8.2.4",
        "@diia-inhouse/types": "13.2.0",
        "@types/lodash.frompairs": "4.0.9",
        "@types/luxon": "3.7.1",
        "@types/node": "25.6.2",
        "@vitest/coverage-v8": "4.1.5",
        "@vitest/ui": "4.1.5",
        "lockfile-lint": "5.0.0",
        "madge": "8.0.0",
        "oxfmt": "0.48.0",
        "oxlint": "1.63.0",
        "oxlint-tsgolint": "0.22.1",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.3",
        "tsdown": "0.22.0",
        "typescript": "5.9.3",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.5"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package",
        "branches": [
            "main"
        ]
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "madge": {
        "tsConfig": "./tsconfig.json"
    }
}
