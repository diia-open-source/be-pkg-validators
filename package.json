{
    "name": "@diia-inhouse/validators",
    "version": "2.3.0",
    "description": "Data validators package",
    "license": "SEE LICENCE IN LICENCE.md",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-pkg-validators",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsdown",
        "semantic-release": "semantic-release",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "bson": "7.3.4",
        "fastest-validator": "1.19.1",
        "lodash.frompairs": "4.0.1",
        "luxon": "3.7.2"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.4.0",
        "@diia-inhouse/errors": "2.3.49",
        "@diia-inhouse/oxc-config": "6.2.1",
        "@diia-inhouse/types": "14.13.3",
        "@types/lodash.frompairs": "4.0.9",
        "@types/luxon": "3.7.6",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.1.1",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "oxlint-tsgolint": "7.0.2008",
        "rimraf": "6.1.4",
        "semantic-release": "25.0.9",
        "tsdown": "0.23.7",
        "typescript": "5.9.3",
        "vitest": "5.1.1"
    },
    "peerDependencies": {
        "@diia-inhouse/errors": ">=2.0.0",
        "@diia-inhouse/types": ">=13.1.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "engines": {
        "node": ">=24"
    }
}
